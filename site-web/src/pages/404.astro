---
import Layout from '../layouts/Layout.astro';
import LogoMark from '../components/LogoMark.astro';
---
<Layout title="Page introuvable — Cladéys" description="Cette page n’existe pas. Retour à l’accueil de Cladéys." noindex>
  <section class="lost">
    <div class="container lost__inner">
      <div class="lost__arch" aria-hidden="true">
        <svg viewBox="0 0 520 620" fill="none" stroke="#ceab70" stroke-linecap="round" stroke-linejoin="round">
          <path d="M 40 600 V 300 A 220 220 0 0 1 480 300 V 600" stroke-width="2.4" />
          <path d="M 70 600 V 300 A 190 190 0 0 1 450 300 V 600" stroke-width="1.2" opacity="0.8" />
          <path d="M 0 600 H 520 M 0 612 H 520" stroke-width="1.4" />
        </svg>
        <div class="lost__mark"><LogoMark class="lost__mark-svg" /></div>
      </div>
      <p class="eyebrow eyebrow--rule">Erreur 404</p>
      <h1 class="lost__title">Cette porte ne mène nulle part.</h1>
      <p class="lede lost__lede">La page que vous cherchez n’existe pas, ou plus. La galerie, elle, est toujours ouverte.</p>
      <a class="btn btn--solid" href="/">Retour à l’accueil</a>
    </div>
  </section>
</Layout>

<style is:global>
  .lost__mark-svg { width: 100%; height: auto; color: var(--ivory); }
</style>
<style>
  .lost {
    min-height: 100vh; min-height: 100svh;
    display: grid; place-items: center;
    padding: 8rem 0 5rem;
    background: radial-gradient(ellipse 70% 60% at 50% 40%, var(--navy) 0%, var(--navy-night) 70%);
  }
  .lost__inner { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1.4rem; max-width: 760px; }
  .lost__arch { position: relative; width: min(60%, 260px); aspect-ratio: 520 / 620; margin-bottom: 0.5rem; }
  .lost__arch svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .lost__mark { position: absolute; left: 50%; top: 58%; width: 34%; transform: translate(-50%, -50%); }
  .lost__title { font-size: clamp(2.2rem, 1.6rem + 2.6vw, 4rem); line-height: 1.05; }
  .lost__lede { color: var(--ivory-70); max-width: 44ch; }
</style>
